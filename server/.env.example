SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
APP_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_JWT_ACCESS_TTL=30m
APP_JWT_ISSUER=vf-api
APP_JWT_AUDIENCE=vf-client
APP_REFRESH_TOKEN_TTL_DAYS=30
APP_REFRESH_COOKIE_NAME=vf_refresh_token
# Seconds a just-rotated refresh token still works, so two tabs refreshing at the
# same moment are not mistaken for a stolen token. 0 disables the window.
APP_REFRESH_REUSE_GRACE_SECONDS=30
ORIGIN_URL=http://localhost:5173
CLIENT_ORIGINS=
API_PUBLIC_URL=http://localhost:3000

# request.ip keys the rate limiter and fills auth_sessions.ip_address. Leave unset
# when the server is exposed directly. Behind a proxy or load balancer set the
# trusted hop count ("1") or the proxy addresses ("10.0.0.0/8,192.168.0.0/16"),
# otherwise every client shares one rate-limit bucket. Never set "true" unless the
# server is unreachable except through a proxy that overwrites X-Forwarded-For.
# TRUST_PROXY=1

# Production cross-site frontend/API deployments normally require both:
# APP_REFRESH_COOKIE_SECURE=true
# APP_REFRESH_COOKIE_SAME_SITE=none


# --- Microsoft Teams Workflows webhook -----------------------------------------
# Base of the "Xem chi tiết" link in Teams messages; the link is
# {APP_BASE_URL}/workspace/orders/{order_id}.
APP_BASE_URL=https://edcthink.pro
# Hosts a Workflow URL may point at (comma-separated, "*." = any subdomain).
# Unset uses the defaults below. Anything else is refused on save and on send.
TEAMS_WEBHOOK_ALLOWED_HOSTS=https://defaulted6a2939d1534f9294f83d790d96c9.f8.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/22/workflows/481cd9872be24c89b1288a203de7d11a/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=5AvoYUWxf8NqKGuC76n4U1u3Bo0IFgUDMnOh_q5uvZ8
# The outbox sweep (every 15s) runs inside the API process. Set false only for
# one-off scripts; a queued message then leaves on the next status change.
TEAMS_DISPATCHER_ENABLED=true# Workflow HTTP POST URL per Teams function: TEAMS_WEBHOOK_URL_<FUNCTION_CODE>.
# Secret; never stored in the database. Changing it needs a server restart.
TEAMS_WEBHOOK_URL_ORDER_STATUS_CHANGED=
