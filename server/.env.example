SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
APP_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_JWT_ACCESS_TTL=30m
APP_JWT_ISSUER=vf-api
APP_JWT_AUDIENCE=vf-client
APP_REFRESH_TOKEN_TTL_DAYS=30
APP_REFRESH_COOKIE_NAME=vf_refresh_token
# Seconds a just-rotated refresh token still works, so two tabs refreshing at the
# same moment are not mistaken for a stolen token. 0 disables the window.
APP_REFRESH_REUSE_GRACE_SECONDS=30
ORIGIN_URL=http://localhost:5173
CLIENT_ORIGINS=
API_PUBLIC_URL=http://localhost:3000

# request.ip keys the rate limiter and fills auth_sessions.ip_address. Leave unset
# when the server is exposed directly. Behind a proxy or load balancer set the
# trusted hop count ("1") or the proxy addresses ("10.0.0.0/8,192.168.0.0/16"),
# otherwise every client shares one rate-limit bucket. Never set "true" unless the
# server is unreachable except through a proxy that overwrites X-Forwarded-For.
# TRUST_PROXY=1

# Production cross-site frontend/API deployments normally require both:
# APP_REFRESH_COOKIE_SECURE=true
# APP_REFRESH_COOKIE_SAME_SITE=none

