{
  "name": "server",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && c8 node --test -r ts-node/register \"test/**/*.ts\"",
    "test:auth:integration": "npm run build:ts && node test/integration/auth-session-http.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:ts": "npm run clean && tsc",
    "build": "npm run build:ts",
    "auth:bootstrap-admin": "npm run build:ts && node -r dotenv/config dist/scripts/bootstrap-admin-password.js",
    "start": "fastify start --options --address 0.0.0.0 --log-level info dist/app.js",
    "dev": "nodemon --watch \"./**/*.ts\" --ignore node_modules --ext ts --exec \"npm run build:ts && fastify start --options -l info -P dist/app.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@supabase/supabase-js": "^2.105.4",
    "dotenv": "^17.4.2",
    "exceljs": "4.4.0",
    "fastify": "^5.0.0",
    "fastify-cli": "^7.4.1",
    "fastify-plugin": "^5.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.8",
    "@types/pg": "^8.23.1",
    "c8": "^10.1.2",
    "fastify-tsconfig": "^3.0.0",
    "nodemon": "^3.1.0",
    "pino-pretty": "^13.1.3",
    "supabase": "^2.109.1",
    "ts-node": "^10.4.0",
    "typescript": "~5.9.2"
  }
}
